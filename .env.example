# API
DATABASE_URL=postgres://puente:puente@localhost:5432/puente
PORT=3000
# "development" enables /v1/dev/* routes and returns OTP codes in responses. NEVER in production.
NODE_ENV=development
# Required when NODE_ENV is not development/test (the API refuses to start without them):
# OTP_PEPPER=<random 32+ bytes>
# CUSTODY_WEBHOOK_SECRET=<shared secret from the custodian>
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000
