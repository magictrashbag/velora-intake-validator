{
  "name": "@puente/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "staff": "node --import tsx src/cli/staff.ts"
  },
  "dependencies": {
    "@puente/core": "0.1.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
